# Eagler Touhou netplay relay. Copy to /etc/eagler-touhou/relay.env.
EAGLER_NETPLAY_RELAY_HOST=127.0.0.1
EAGLER_NETPLAY_RELAY_PORT=18142
EAGLER_NETPLAY_GAMEPLAY_RELAY_FALLBACK=0
# Exact proxy address used by the accompanying loopback proxy example.
EAGLER_NETPLAY_TRUSTED_PROXIES=127.0.0.1
EAGLER_NETPLAY_STUN_URLS=stun:stun.cloudflare.com:3478

# Optional public nicknames. Keep the API key and SQLite state outside the site.
# Node.js 22.13+ is required. Moderation and SQL run in a dedicated worker.
# EAGLER_NETPLAY_PUBLIC_NICKNAMES=1
# EAGLER_NETPLAY_NICKNAME_STATE=/var/lib/eagler-touhou/nicknames/names.sqlite
# EAGLER_NETPLAY_NICKNAME_API_KEY=SET_PRIVATE_SERVER_KEY
# EAGLER_NETPLAY_NICKNAME_API_BASE=https://api.deepseek.com
# EAGLER_NETPLAY_NICKNAME_MODEL=deepseek-flash
# EAGLER_NETPLAY_NICKNAME_IP_HOURLY_LIMIT=5
# EAGLER_NETPLAY_NICKNAME_IP_DAILY_LIMIT=20
# EAGLER_NETPLAY_NICKNAME_DAILY_BUDGET=1000

# Optional TURN. Use the same shared secret in turn.env and relay.env.
# EAGLER_NETPLAY_TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
# EAGLER_NETPLAY_TURN_SHARED_SECRET=CHANGE_ME_SAME_AS_COTURN
# EAGLER_NETPLAY_TURN_TTL_SECONDS=3600
# Optional dynamic JSON with paired urls and sharedSecret, atomically replaced.
# EAGLER_NETPLAY_TURN_CONFIG_FILE=/etc/eagler-touhou/active-turn.json

# Legacy TH07_* names are accepted only as compatibility aliases for existing
# deployments. New deployments should use EAGLER_NETPLAY_* exclusively.
