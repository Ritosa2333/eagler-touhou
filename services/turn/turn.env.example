# Shared by coturn and netplay-relay.mjs. Keep the real file outside the repository.
EAGLER_NETPLAY_TURN_REALM=turn.example.com
EAGLER_NETPLAY_TURN_SHARED_SECRET=CHANGE_ME

# Signaling sends these URLs to browsers. Start with UDP + TCP on 3478.
EAGLER_NETPLAY_TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
EAGLER_NETPLAY_STUN_URLS=stun:stun.cloudflare.com:3478
EAGLER_NETPLAY_TURN_TTL_SECONDS=3600

# Conservative defaults for the current ~10 Mbps VPS.
EAGLER_NETPLAY_TURN_USER_QUOTA=12
EAGLER_NETPLAY_TURN_TOTAL_QUOTA=256
EAGLER_NETPLAY_TURN_MAX_BPS=131072
EAGLER_NETPLAY_TURN_BPS_CAPACITY=786432

# TURN relay port range. Open UDP for this range in the host/cloud firewall.
EAGLER_NETPLAY_TURN_MIN_PORT=49152
EAGLER_NETPLAY_TURN_MAX_PORT=65535

# Usually unnecessary on a VPS with its public address directly assigned.
# EAGLER_NETPLAY_TURN_EXTERNAL_IP=203.0.113.10
# EAGLER_NETPLAY_TURN_LISTENING_IP=0.0.0.0
# EAGLER_NETPLAY_TURN_RELAY_IP=0.0.0.0

# Optional TURN/TLS. When enabled, also add a turns: URL to EAGLER_NETPLAY_TURN_URLS.
# EAGLER_NETPLAY_TURN_CERT=/etc/letsencrypt/live/turn.example.com/fullchain.pem
# EAGLER_NETPLAY_TURN_PKEY=/etc/letsencrypt/live/turn.example.com/privkey.pem
# EAGLER_NETPLAY_TURN_TLS_LISTENING_PORT=5349

# Legacy TH07_* names are accepted only as compatibility aliases for existing
# deployments. Do not copy them into new configuration.
