# HTTP -> HTTPS migration window. Replace YOUR_DOMAIN and certificate paths.
# Exact HTTP /migrate.html stays reachable; do not enable HSTS in this phase.
server {
    listen 80;
    listen [::]:80;
    server_name YOUR_DOMAIN;
    root /var/www/eagler-touhou;
    location = /migrate.html {
        add_header Cache-Control "no-cache";
        try_files /migrate.html =404;
    }
    location / { return 308 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name YOUR_DOMAIN;
    ssl_certificate /etc/letsencrypt/live/YOUR_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/YOUR_DOMAIN/privkey.pem;
    include /etc/nginx/snippets/eagler-touhou-site.conf;
}
