{
  "name": "eagler-touhou-self-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "host": "bun host/build.mjs",
    "host:build": "bun host/build.mjs --build-only",
    "host:doctor": "bun scripts/inspect-host.mjs",
    "package:external-site": "bun scripts/package-external-site.mjs",
    "import": "bun host/build-import.mjs",
    "verify:deployed": "bun scripts/verify-deployed-site.mjs",
    "verify:server": "bun scripts/verify-server-build.mjs"
  },
  "dependencies": {
    "acorn": "8.18.0",
    "fflate": "0.8.3",
    "parse5": "8.0.1",
    "workbox-build": "7.4.1"
  },
  "overrides": {
    "minimatch@5": {
      "brace-expansion": "2.1.7"
    },
    "minimatch@10": {
      "brace-expansion": "5.0.12"
    }
  },
  "packageManager": "bun@1.4.4"
}
