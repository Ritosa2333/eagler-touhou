+}
+void clear_input(){held.fill(false);pressed.fill(false);edges.clear();owned_pointer=mouse_down=false;mouse_x=mouse_y=-FLT_MAX;}
+void mouse_motion(float x,float y){if(captures()){mouse_x=x*640;mouse_y=y*480;}}
