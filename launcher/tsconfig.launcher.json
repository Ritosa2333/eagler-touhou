{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": ".cache/build/browser/assets",
    "strict": true,
    "noEmitOnError": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": false,
    "types": [],
    "erasableSyntaxOnly": true
  },
  "include": ["src/**/*.mts"]
}
