# Ready-to-run release, following the other TH projects' root allowlist.
# Development sources, raw assets, tools and reports remain local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/README-NETPLAY.md
!/web/
!/server.py
!/lan_server.py
!/replay_history.py
!/relay_server.py
!/turn_service.py
!/public_tunnel.py
!/configure_turn.py
!/requirements-relay.txt
!/start-web.bat
!/start.bat
!/README-PUBLIC.md
!/start-native.bat
!/start-lan.bat
!/start-public-tunnel.bat
!/configure-turn.bat
!/start-stage5.bat
!/start-stage10-makai.bat
!/start-stage10-jigoku.bat
!/start-stage15-makai.bat
!/start-stage15-jigoku.bat
!/start-stage20-makai.bat
!/start-stage20-jigoku.bat
!/start-ending-makai.bat

# Ship the standalone Windows executable, without toolchains or build caches.
!/build/
/build/*
!/build/th01-native.exe

# web/ is the complete runtime: keep game.wasm, JS, audio and JSON manifests.
# Never ignore *.wasm or audio globally: checkout must run without a rebuild.
/web/baseline/
/web/build/
/web/extracted/
/web/reports/
/web/screenshots/
/web/backups/
/web/tools/
/web/vendor-source/
/web/**/test-results/
/web/**/playwright-report/
/web/**/*-candidate.wasm
/web/**/*-probe.wasm
/web/**/*.wat
/web/**/*.lst
/web/**/*.cpuprofile
/web/**/*.heapsnapshot

# Credentials, generated tunnel URLs, caches and temporary files stay local.
turn-config.local.json
public-test-url.txt
__pycache__/
*.py[cod]
node_modules/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.DS_Store
Thumbs.db
Desktop.ini
*.log
*.tmp
*.swp
*.bak
*.backup
*.bak.*
*.orig
*~
.idea/
.vscode/
.env
.env.*
th01-*-fault.json
th01-*-diagnostics.json

# Main-project adaptation sources and generated output.
!/scripts/
!/tests/
!/.gitattributes
!/README-UPSTREAM.md
!/ADAPTATION.md
!/source-import.json
!/docs/
/build-eagler/
/content/
/.cache/
/artwork/

