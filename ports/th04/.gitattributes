# Auto detect text files and perform LF normalization
* text=auto

# Preserve the bytes used by the optimized runtime's SHA-256 manifests.
/web/dosbox-adapter.js text eol=lf
/web/netplay/room.js text eol=lf
/web/vendor/dosbox-x/dosbox-rollback.mjs text eol=lf
/web/vendor/dosbox-x/dosbox-rollback-tracked.mjs text eol=lf
/web/vendor/dosbox-x/NOTICE.md text eol=lf

# Preserve deployed Runtime bytes, including manifest-covered line endings.
/web/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
# Generated vendor code retains upstream whitespace and byte identities.
/web/vendor/** whitespace=-blank-at-eol,cr-at-eol
