!/tools/test_practice_browser.cjs

# Main-project adaptation sources and generated output.
!/scripts/
!/tests/
!/.gitattributes
!/README-UPSTREAM.md
!/ADAPTATION.md
!/source-import.json
!/docs/
/build-eagler/
/content/
/.cache/
/artwork/

