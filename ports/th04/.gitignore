# th04-coop-lab now ships DOSBox-X. Keep the ready-to-run distribution;
# development files and the sibling th04-np21 backup remain local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/README-RELAY.md
!/LAN-试玩说明.md
!/web/
!/server.py
!/web_server.py
!/lan_server.py
!/replay_history.py
!/relay_server.py
!/turn_service.py
!/public_tunnel.py
!/configure_turn.py
!/requirements-relay.txt
!/start.bat
!/start-solo.bat
!/start-lan.bat
!/start-public-tunnel.bat
!/install-relay.bat
!/configure-turn.bat

# The root allowlist excludes tools/, patches/, reports/, DEVELOPMENT.md,
# build/, baseline/, extracted/, reference/, vendor-source/, local credentials,
# tunnel URL files and any future development-only root files by default.
# Keep runtime JS/WASM, fonts, music, assets and JSON manifests.
# web/vendor/dosbox-x/ is shipped, including .mjs glue, all runtime WASM,
# runtime.json, audio-worklet.js, NOTICE.md and LICENSE. Do not ignore *.wasm
# or *.mjs globally: a fresh checkout must start without rebuilding.
# Only the four patched game disks (solo/co-op, Chinese/Japanese) ship.
# The supplied 4-cn source and Japanese baseline stay outside web/.
/web/*.hdi
/web/*.hdi.gz
!/web/th04-coop.hdi.gz
!/web/th04-solo.hdi.gz
!/web/th04-coop-jp.hdi.gz
!/web/th04-solo-jp.hdi.gz
/web/disks/

# Development output must not leak into web/ when copied there for inspection.
/web/baseline/
/web/build/
/web/extracted/
/web/reports/
/web/screenshots/
/web/backups/
/web/th04-np21/
/web/tools/
/web/vendor-source/

# Browser test artifacts and instrumented emulator binaries are local-only.
# solo-test-tools.js and solo-performance.js are shipped player features.
/web/**/test-results/
/web/**/playwright-report/
/web/**/guest-*.wasm
/web/**/extra-probe.wasm
/web/**/extra-raw.wasm
/web/**/*.wat
/web/**/*.lst
/web/**/*.cpuprofile
/web/**/*.heapsnapshot

# DOSBox source maps, disassembly and experimental cores are build artifacts.
/web/vendor/dosbox-x/*.map
/web/vendor/dosbox-x/*.symbols
/web/vendor/dosbox-x/*.tgz
/web/vendor/dosbox-x/*-candidate.wasm
/web/vendor/dosbox-x/*-probe.wasm
/web/vendor/dosbox-x/*-dbg.*

# Retired assets are not used by the current game.
/web/local-music-disk.json
/web/local-music-patch.json
/web/netplay/frame-queue.js
/web/netplay/input-wire.js

# Do not upload caches or local configuration even inside an allowed directory.
__pycache__/
*.py[cod]
node_modules/
.pytest_cache/
.ruff_cache/
.DS_Store
Thumbs.db
Desktop.ini
*.log
*.tmp
*.swp
*.bak
*.orig
*~
# Downloaded per-device diagnostics are not release assets.
th04-solo-fault.json
th04-network-fault.json
.idea/
.vscode/
.env
.env.*

# Ship only the reviewed core migration sources; keep builds and raw reports local.
