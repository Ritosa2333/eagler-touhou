+std::optional<FmCheckpoint> PmdOpnaEngine::capture_checkpoint(std::uint16_t measure)
+{
+	if(!impl_->active_pmd || impl_->samples_rendered || !impl_->rhythm_rom.empty() ||
+		impl_->decoded_rhythm.present()) return {};
+	FmCheckpoint ck{};
+	ck.interrupts.reserve(100000);
+	ck.statuses.reserve(300000);
+	impl_->capture_overflow = false;
+	impl_->capture = &ck;
+	const auto seek = advance_to_measure(measure, 166400ULL * 600);
+	impl_->capture = nullptr;
+	if(!seek || impl_->capture_overflow) return {};
+	const auto s = status();
+	ck.measure = s.measure;
+	ck.ticks = s.timer_b_count;
+	ck.native_samples = s.samples_rendered;
+	ck.writes = s.register_writes;
+	ck.write_hash = s.register_hash;
+	ck.deadlines = impl_->timer_deadlines;
+	ck.irq = impl_->irq_asserted;
+	ymfm::ymfm_saved_state state(ck.chip, true);
+	impl_->chip->save_restore(state);
+	return ck;
+}
+
+bool PmdOpnaEngine::restore_checkpoint(FmCheckpoint& ck)
+{
+	if(!impl_->active_pmd || impl_->samples_rendered || !impl_->rhythm_rom.empty() ||
+		impl_->decoded_rhythm.present() || ck.chip.empty() || ck.interrupts.empty() ||
+		ck.native_samples > 166400ULL * 600) return false;
+	const auto end = ck.native_samples * impl_->clocks_per_sample;
+	std::uint32_t at = 0;
+	for(const auto& evt : ck.interrupts) {
+		if(evt.clock < impl_->chip_clocks || evt.clock > end ||
+			evt.status_end <= at || evt.status_end > ck.statuses.size()) return false;
+		impl_->chip_clocks = evt.clock;
+		impl_->replay_statuses = std::span(ck.statuses).subspan(at, evt.status_end - at);
+		impl_->replay_at = 0;
+		impl_->replay_status_overrun = false;
+		th03_pmd_interrupt(impl_->active_pmd.get());
+		const auto consumed = impl_->replay_at == impl_->replay_statuses.size();
+		impl_->replay_statuses = {};
+		if(!consumed || impl_->replay_status_overrun) return false;
+		at = evt.status_end;
+	}
+	const auto s = status();
+	if(at != ck.statuses.size() || s.measure != ck.measure || s.timer_b_count != ck.ticks ||
+		s.register_hash != ck.write_hash || s.register_writes != ck.writes) return false;
+	std::vector<std::uint8_t> expected_chip;
+	ymfm::ymfm_saved_state expected(expected_chip, true);
+	impl_->chip->save_restore(expected);
+	if(ck.chip.size() != expected_chip.size()) return false;
+	ymfm::ymfm_saved_state restored(ck.chip, false);
+	impl_->chip->save_restore(restored);
+	impl_->samples_rendered = ck.native_samples;
+	impl_->chip_clocks = end;
+	impl_->timer_deadlines = ck.deadlines;
+	impl_->irq_asserted = ck.irq;
+	return true;
 }
 
