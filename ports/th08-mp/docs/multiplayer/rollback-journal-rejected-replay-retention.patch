diff --git a/th08_web/cpp/multiplayer/ReplayCheckpoint.hpp b/th08_web/cpp/multiplayer/ReplayCheckpoint.hpp
new file mode 100644
--- /dev/null
+++ b/th08_web/cpp/multiplayer/ReplayCheckpoint.hpp
@@ -0,0 +1,70 @@
+#pragma once
+#include "../game/ReplayRecording.hpp"
+#include <algorithm>
+#include <array>
+#include <memory>
+
+namespace th08::multiplayer {
+// Keep the existing owning, whole-recording copy. ReplayStream overwrites
+// reserved input words and the last timing byte, so length-only undo is unsafe.
+class ReplayCheckpoint {
+public:
+    // This bounds idle storage, not admissible Replay size. Larger recordings
+    // use the original deep-copy path and release their storage on retirement.
+    static constexpr std::size_t MaxRetainedBytes=1024*1024;
+
+    void Capture(const ReplayRecording& source){
+        if(value&&reusable){
+            bool fits=true;
+            for(i32 stage=0;stage<9;++stage){
+                const auto& input=source.stage(stage)->stream;
+                const auto& saved=value->stage(stage)->stream;
+                if(input.input.size()>saved.input.capacity()||input.timing.size()>saved.timing.capacity()){fits=false;break;}
+            }
+            if(fits){*value=source;return;}
+        }
+        std::array<std::size_t,18> capacities{};
+        std::size_t total=sizeof(ReplayRecording),index=0;
+        for(i32 stage=0;stage<9;++stage){
+            const auto& input=source.stage(stage)->stream;
+            const auto* saved=value?&value->stage(stage)->stream:nullptr;
+            const auto plan=[&](const std::vector<u8>& bytes,std::size_t capacity){
+                if(capacity<bytes.size())
+                    capacity=std::max(bytes.size(),std::min(MaxRetainedBytes,capacity*2));
+                capacities[index++]=capacity;total+=capacity;
+            };
+            plan(input.input,saved?saved->input.capacity():0);
+            plan(input.timing,saved?saved->timing.capacity():0);
+        }
+        if(total>MaxRetainedBytes){
+            value=std::make_unique<ReplayRecording>(source);reusable=false;
+            return;
+        }
+        if(!value)value=std::make_unique<ReplayRecording>();
+        index=0;
+        for(i32 stage=0;stage<9;++stage){
+            auto& saved=value->stage(stage)->stream;
+            saved.input.reserve(capacities[index++]);
+            saved.timing.reserve(capacities[index++]);
+        }
+        *value=source;
+        reusable=CapacityBytes()<=MaxRetainedBytes;
+    }
+    void Restore(ReplayRecording& target)const{target=*value;}
+    const ReplayRecording& Value()const{return *value;}
+    void Retire(){if(!reusable)value.reset();}
+    void Clear(){value.reset();reusable=false;}
+    std::size_t CapacityBytes()const{
+        if(!value)return 0;
+        std::size_t total=sizeof(ReplayRecording);
+        for(i32 stage=0;stage<9;++stage){
+            const auto& stream=value->stage(stage)->stream;
+            total+=stream.input.capacity()+stream.timing.capacity();
+        }
+        return total;
+    }
+private:
+    std::unique_ptr<ReplayRecording> value;
+    bool reusable=false;
+};
+}
diff --git a/portable/multiplayer/replay-checkpoint-check.cpp b/portable/multiplayer/replay-checkpoint-check.cpp
new file mode 100644
--- /dev/null
+++ b/portable/multiplayer/replay-checkpoint-check.cpp
@@ -0,0 +1,177 @@
+#include "../../th08_web/cpp/multiplayer/ReplayCheckpoint.hpp"
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <new>
+
+namespace {
+bool count_allocations=false;
+std::size_t allocations=0,checks=0;
+void require(bool value,const char* reason){
+    ++checks;if(!value){std::fprintf(stderr,"FAIL: %s\n",reason);std::exit(1);}
+}
+}
+void* operator new(std::size_t size){
+    if(count_allocations)++allocations;
+    if(void* p=std::malloc(size?size:1))return p;std::abort();
+}
+void* operator new[](std::size_t size){return ::operator new(size);}
+void operator delete(void* p)noexcept{std::free(p);}
+void operator delete[](void* p)noexcept{std::free(p);}
+void operator delete(void* p,std::size_t)noexcept{std::free(p);}
+void operator delete[](void* p,std::size_t)noexcept{std::free(p);}
+
+using namespace th08;
+using multiplayer::ReplayCheckpoint;
+namespace {
+template<class T>bool same(const T& a,const T& b){return std::memcmp(&a,&b,sizeof(T))==0;}
+bool equal(const ReplayRecording& a,const ReplayRecording& b){
+    if(a.ready()!=b.ready()||a.current()!=b.current()||!same(a.metadata(),b.metadata())||
+       !same(a.input,b.input)||!same(a.frame_state,b.frame_state)){
+        std::fprintf(stderr,"record mismatch ready=%d current=%d metadata=%d input=%d frame=%d\n",
+            a.ready()==b.ready(),a.current()==b.current(),same(a.metadata(),b.metadata()),same(a.input,b.input),same(a.frame_state,b.frame_state));return false;
+    }
+    for(i32 i=0;i<9;++i){
+        const auto& x=*a.stage(i);const auto& y=*b.stage(i);
+        const auto& s=x.stream;const auto& t=y.stream;
+        if(x.present!=y.present||!same(x.snapshot,y.snapshot)||s.frame!=t.frame||
+           s.transition_frames!=t.transition_frames||s.input_cursor!=t.input_cursor||
+           s.timing_cursor!=t.timing_cursor||s.input_end!=t.input_end||s.timing_end!=t.timing_end||
+           s.input!=t.input||s.timing!=t.timing){std::fprintf(stderr,"stream mismatch stage=%d\n",i);return false;}
+        // Exercise the private playback stride independently after restoring.
+        auto p=s,q=t;ReplayInputState left{},right{};
+        // These are fresh oracle inputs, not restored state. Initialize their
+        // padding too, so the byte comparison cannot read unrelated stack data.
+        std::memset(&left,0,sizeof(left));std::memset(&right,0,sizeof(right));
+        left.flags=right.flags=4;
+        for(i32 step=0;step<3;++step){
+            const bool lp=p.play(left),rp=q.play(right);
+            if(lp!=rp||!same(left,right)||p.input_cursor!=q.input_cursor){
+                std::fprintf(stderr,"play mismatch stage=%d step=%d results=%d/%d cursor=%u/%u\n",i,step,lp,rp,p.input_cursor,q.input_cursor);
+                const auto* lb=reinterpret_cast<const u8*>(&left);const auto* rb=reinterpret_cast<const u8*>(&right);
+                for(std::size_t byte=0;byte<sizeof(left);++byte)if(lb[byte]!=rb[byte])std::fprintf(stderr,"input byte %zu=%u/%u\n",byte,lb[byte],rb[byte]);
+                return false;
+            }
+        }
+    }
+    return true;
+}
+void advance(ReplayRecording& recording,u32 frame){
+    recording.input.flags=4;recording.input.physical=u16(frame*37);
+    recording.input.timing_level=u8(40+frame%21);recording.input.timing_forced=frame%3==0;
+    recording.frame_state.seed=u16(frame*117);recording.frame_state.flags=u16(frame);
+    for(i32 i=0;i<9;++i)recording.stage(i)->stream.record(recording.input);
+}
+ReplayRecording seed_recording(){
+    ReplayRecording result;
+    for(i32 i=0;i<9;++i){
+        auto& stage=*result.stage(i);stage.present=true;
+        std::memset(&stage.snapshot,17+i,sizeof(stage.snapshot));
+        stage.stream.begin_record(u16(100+i));
+    }
+    return result;
+}
+void byte_checks(){
+    auto source=seed_recording();
+    ReplayCheckpoint checkpoint;
+    for(u32 frame=0;frame<96;++frame){
+        const ReplayRecording expected=source;
+        checkpoint.Capture(source);
+        advance(source,frame);
+        ReplayRecording restored;checkpoint.Restore(restored);
+        require(equal(expected,restored),"all stage words, stream bytes and cursors");
+        advance(restored,frame);
+        require(equal(source,restored),"record again across input seed and timing-tail overwrites");
+        checkpoint.Retire();
+    }
+    const auto old=source;
+    checkpoint.Capture(source);source.reset();checkpoint.Restore(source);
+    require(equal(old,source),"reset then complete owning restore");
+    for(i32 stage=0;stage<9;++stage){
+        auto& stream=source.stage(stage)->stream;
+        const u8 keys[24]{1,0,3,4,5,6,2,0,9,10,11,12,3,0,15,16,17,18,4,0,21,22,23,24};
+        const u8 times[4]{60,60,60,60};
+        require(stream.begin_playback(keys,sizeof(keys),times,sizeof(times),true),"debug stride setup");
+    }
+    const auto playback=source;checkpoint.Capture(source);
+    for(i32 stage=0;stage<9;++stage)source.stage(stage)->stream.begin_record(77);
+    checkpoint.Restore(source);require(equal(playback,source),"private debug playback stride");
+    for(i32 stage=0;stage<9;++stage)source.stage(stage)->stream.stop_recording();
+    const auto stopped=source;checkpoint.Capture(source);source.reset();checkpoint.Restore(source);
+    require(equal(stopped,source),"stop suffix and zero padding");
+    checkpoint.Retire();require(checkpoint.CapacityBytes()<=ReplayCheckpoint::MaxRetainedBytes,"bounded idle cache");
+    checkpoint.Clear();require(checkpoint.CapacityBytes()==0,"clear releases all cached buffers");
+
+    auto large=seed_recording();
+    large.stage(0)->stream.input.resize(ReplayCheckpoint::MaxRetainedBytes+17,0x65);
+    checkpoint.Capture(large);source.reset();checkpoint.Restore(source);
+    require(equal(large,source),"large valid checkpoint uses unchanged complete-copy fallback");
+    checkpoint.Retire();require(checkpoint.CapacityBytes()==0,"large retired recording is not retained");
+    auto near=seed_recording();near.stage(0)->stream.input.resize(600*1024,0x39);
+    checkpoint.Capture(near);checkpoint.Retire();
+    require(checkpoint.CapacityBytes()!=0,"sub-budget initial capacity retained");
+    near.stage(0)->stream.input.push_back(0x71);
+    checkpoint.Capture(near);checkpoint.Restore(source);
+    require(equal(near,source),"geometric capacity planning overflow keeps exact copy");
+    checkpoint.Retire();require(checkpoint.CapacityBytes()==0,"planning overflow also releases idle storage");
+    source=seed_recording();checkpoint.Capture(source);checkpoint.Retire();
+    require(checkpoint.CapacityBytes()!=0&&checkpoint.CapacityBytes()<=ReplayCheckpoint::MaxRetainedBytes,"large-to-small returns to reuse");
+}
+void growth_checks(){
+    std::array<ReplayCheckpoint,8> slots;
+    auto source=seed_recording();
+    allocations=0;count_allocations=true;
+    for(u32 frame=0;frame<512;++frame){
+        auto& checkpoint=slots[frame%slots.size()];checkpoint.Capture(source);checkpoint.Retire();
+        advance(source,frame);
+    }
+    count_allocations=false;const auto growth_allocations=allocations;
+    // Warm every slot with the largest payload before measuring steady reuse.
+    for(auto& checkpoint:slots){checkpoint.Capture(source);checkpoint.Retire();}
+    allocations=0;count_allocations=true;
+    for(u32 frame=0;frame<512;++frame){
+        auto& checkpoint=slots[frame%slots.size()];checkpoint.Capture(source);checkpoint.Retire();
+    }
+    count_allocations=false;
+    require(allocations==0,"warmed eight-slot recording copies allocate zero times");
+    for(const auto& slot:slots)require(slot.CapacityBytes()<=ReplayCheckpoint::MaxRetainedBytes,"every idle slot stays bounded");
+    std::printf("growth_allocations=%zu warmed_capture_allocations=%zu\n",growth_allocations,allocations);
+}
+void benchmark(){
+    // MP disables ordinary ReplayRecording. Measure that real empty-stream
+    // shape separately from the larger compatibility/ownership stress case.
+    for(const bool filled:{false,true}){
+    ReplayRecording source{};if(filled)source=seed_recording();
+    if(filled)for(i32 stage=0;stage<9;++stage){
+        source.stage(stage)->stream.input.resize(2048*(stage+1),u8(17+stage));
+        source.stage(stage)->stream.timing.resize(128*(stage+1),u8(40+stage));
+    }
+    ReplayRecording restored=source;
+    std::array<ReplayCheckpoint,8> retained;
+    std::array<std::unique_ptr<ReplayRecording>,8> legacy;
+    for(auto& checkpoint:retained){checkpoint.Capture(source);checkpoint.Retire();}
+    const u32 iterations=filled?2000:20000;
+    for(const u32 depth:{1u,8u})for(const bool reuse:{false,true,true,false}){
+        for(auto& checkpoint:legacy)checkpoint.reset();
+        for(u32 slot=0;slot<depth;++slot)legacy[slot]=std::make_unique<ReplayRecording>(source);
+        allocations=0;count_allocations=true;
+        const auto start=std::chrono::steady_clock::now();
+        for(u32 iteration=0;iteration<iterations;++iteration){
+            const auto slot=iteration%depth;
+            if(reuse){retained[slot].Capture(source);retained[slot].Restore(restored);retained[slot].Retire();}
+            else{legacy[slot].reset();legacy[slot]=std::make_unique<ReplayRecording>(source);restored=*legacy[slot];}
+        }
+        const auto elapsed=std::chrono::duration<double,std::milli>(std::chrono::steady_clock::now()-start).count();
+        count_allocations=false;
+        require(equal(source,restored),"benchmark restore matches independent full copy");
+        if(reuse)require(allocations==0,"benchmark warmed retained allocations");
+        std::printf("benchmark payload=%s depth=%u reuse=%d iterations=%u allocations=%zu ms=%.6f\n",filled?"filled":"empty",depth,reuse,iterations,allocations,elapsed);
+    }
+    }
+}
+}
+int main(){
+    byte_checks();growth_checks();benchmark();
+    std::printf("Replay checkpoint PASS checks=%zu\n",checks);return 0;
+}
