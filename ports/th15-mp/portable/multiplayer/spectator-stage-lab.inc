std::vector<u8> spectator_lab_capsule;
std::vector<u8> spectator_lab_logic_bytes;
std::array<unsigned,6> spectator_lab_groups{};
std::vector<unsigned> spectator_lab_rows;
unsigned spectator_lab_frame=0;
unsigned spectator_lab_saved_frame=0;
unsigned spectator_lab_hash(const std::vector<u8>& bytes){unsigned hash=2166136261u;for(auto byte:bytes)hash=(hash^byte)*16777619u;return hash;}
// Diagnostic-only scalar bytes. This is a comparison trace, with no decoder
// or restore path. Preserve every numeric bit and every active owner rather
// than applying the bounded, finite-value rules of a Replay wire header.
struct SpectatorDiagnosticWords {
 std::vector<u8> bytes;
 template<class T> bool Value(const T& v){static_assert(std::is_arithmetic_v<T>||std::is_enum_v<T>);const auto* p=reinterpret_cast<const u8*>(&v);bytes.insert(bytes.end(),p,p+sizeof(v));return true;}
 template<class... T> bool Values(const T&... v){return (Value(v)&&...);}
 template<class R> bool Array(const R& r){for(const auto& v:r)Value(v);return true;}
 const std::vector<u8>& Bytes()const{return bytes;}
};
void spectator_lab_logic(std::vector<u8>& bytes,GameBattle& battle){
 spectator_lab_groups.fill(0);spectator_lab_groups[0]=spectator_lab_hash(bytes);spectator_lab_rows={0};
 auto bits=[](float value){unsigned word;std::memcpy(&word,&value,4);return word;};
 auto row=[&](unsigned type,unsigned id,std::initializer_list<unsigned> values){spectator_lab_rows.push_back(type);spectator_lab_rows.push_back(id);spectator_lab_rows.push_back(unsigned(values.size()));spectator_lab_rows.insert(spectator_lab_rows.end(),values);};
 row(3,0,{unsigned(app->progress.stage),unsigned(app->progress.stage_frame),unsigned(battle.score.score),unsigned(battle.score.point_value),unsigned(battle.score.graze_total),unsigned(battle.mp_fragments)});
 for(unsigned seat=0;seat<battle.mp_options.seat_count;seat++){
  const auto& p=*battle.pilots[seat];row(4,seat,{unsigned(p.session.extra_lives),unsigned(p.session.life_pieces),unsigned(p.session.bombs),unsigned(p.session.power),unsigned(p.player->motion.position_fixed.x),unsigned(p.player->motion.position_fixed.y),unsigned(p.player->life.state),unsigned(p.ghost),p.ghost_random,p.ghost_clock,unsigned(p.ghost_dx),unsigned(p.ghost_dy),p.keys.held,p.keys.pressed,p.life_hold,p.power_taps,p.power_gap,unsigned(p.life_latched)});
 }
 SpectatorDiagnosticWords w;std::vector<u8> logic;
 auto flush=[&](){logic.insert(logic.end(),w.Bytes().begin(),w.Bytes().end());w=SpectatorDiagnosticWords{};};
 size_t section_start=0;
 auto section=[&](unsigned index){flush();unsigned hash=2166136261u;for(size_t i=section_start;i<logic.size();++i)hash=(hash^logic[i])*16777619u;spectator_lab_groups[index]=hash;section_start=logic.size();};
 auto timer=[&](const Timer& t){return w.Values(t.previous,t.current,t.fractional,t.rate_index,t.flags);};
 auto motion=[&](const MotionState& m){return w.Values(m.position.x,m.position.y,m.position.z,m.origin.x,m.origin.y,m.origin.z,m.speed,m.angle,m.radius,m.angular_velocity,m.axis_angle,m.axis_scale,m.phase,m.velocity.x,m.velocity.y,m.velocity.z,m.flags);};
 w.Values(battle.enemies->next_identifier,battle.enemies->rate,battle.enemies->count());timer(battle.enemies->timer);flush();
 for(u32 n=0;n<battle.enemies->count();n++){
  auto& e=*battle.enemies->at(n);auto& s=e.state;
  w.Values(s.id,s.parent_id,s.flags,s.life,s.initial_life,s.phase_life,s.pending_damage,s.cumulative_damage,s.lifecycle_flags);motion(s.motion);motion(s.absolute);motion(s.relative);timer(s.age_timer);timer(s.lifetime_timer);timer(s.phase_timer);w.Array(s.integer_registers);w.Array(s.float_registers);
  w.Value(e.scripts.count());flush();for(u32 thread=0;thread<e.scripts.count();thread++){
   EclFile codec;EclFile::Block block{};if(!codec.write(*e.scripts.at(thread),block)){last_error=codec.error;block.fill(0xff);}logic.insert(logic.end(),block.begin(),block.end());
  }
 }
 section(1);
 for(unsigned seat=0;seat<battle.mp_options.seat_count;seat++){
  auto& player=*battle.pilots[seat]->player;row(5,seat,{unsigned(player.damage.cursor),unsigned(player.damage.maximum_damage),unsigned(player.damage.score),unsigned(player.shots.reward_counters[0]),unsigned(player.shots.reward_counters[1]),unsigned(player.shots.reward_counters[2])});w.Array(player.shots.reward_counters);w.Values(player.damage.cursor,player.damage.maximum_damage,player.damage.score);
  for(const auto& s:player.shots.shots){if(s.state||s.flags)row(6,seat*256+unsigned(s.index),{s.flags,unsigned(s.state),unsigned(s.target),unsigned(s.damage),s.specification,unsigned(s.damage_source)});w.Values(s.flags,s.index,s.state,s.target,s.damage,s.specification,s.damage_source);if(s.flags){motion(s.motion);timer(s.age);timer(s.behavior);timer(s.auxiliary);}}
  // Native allocation, update and collision use bit 0. Other bits on a
  // retired damage source are reusable pool residue, retained only in rows.
  unsigned damage_slot=0;for(const auto& d:player.damage.sources){const auto slot=damage_slot++;if(d.flags)row(7,seat*256+slot,{d.flags,unsigned(d.lifetime.previous),unsigned(d.lifetime.current),bits(d.radius),bits(d.radius_growth),bits(d.angle),bits(d.angular_speed),unsigned(d.damage),unsigned(d.accumulated),unsigned(d.damage_limit),unsigned(d.interval),unsigned(d.last_target),unsigned(d.shot_index),unsigned(d.callback_target),unsigned(d.callback_kind)});w.Value(d.flags&1?d.flags:0u);if(d.flags&1){w.Values(d.radius,d.radius_growth,d.angle,d.angular_speed,d.damage,d.accumulated,d.damage_limit,d.interval,d.last_target,d.shot_index,d.callback_target,d.callback_kind);motion(d.motion);timer(d.lifetime);}}
  flush();
 }
 section(2);
 // Projectile positions, collision timers, future motion programs and item
 // ownership participate independently of UI/ANM allocation statistics.
 auto vec=[&](const Vec3& v){return w.Values(v.x,v.y,v.z);};
 auto initial=[&](const BulletInitialMotion& m){vec(m.position);vec(m.velocity);w.Values(m.speed,m.angle);};
 auto& bullets=battle.bullet_scene->manager;
 w.Values(bullets.first_active(),bullets.first_free(),bullets.visible_count);flush();
 for(u32 slot=bullets.first_active();slot!=BulletManager::none;slot=bullets.next_active(slot)){
  const auto& b=*bullets.state(slot);
  row(1,slot,{unsigned(b.phase),b.flags,b.transform_flags,unsigned(b.transform_index),bits(b.motion.position.x),bits(b.motion.position.y),bits(b.motion.velocity.x),bits(b.motion.velocity.y),bits(b.motion.speed),bits(b.motion.angle),unsigned(b.lifetime.current),unsigned(b.spawn.current),unsigned(b.invulnerability.current),unsigned(b.wait.current),unsigned(b.freeze.current),bits(b.saved.position.x),bits(b.saved.position.y),bits(b.saved.speed),bits(b.saved.angle)});
  w.Value(slot);initial(b.motion);initial(b.saved);
  w.Values(b.flags,b.transform_flags,b.transform_index,b.phase,b.collision_delay,b.cancel_item,b.wait_outside,b.boost_stage,b.step_limit,b.scale,b.offscreen_grace,b.sprite_type,b.color);
  timer(b.boost);timer(b.wait);timer(b.freeze);timer(b.invulnerability);timer(b.lifetime);timer(b.spawn);
  vec(b.acceleration.vector);w.Values(b.acceleration.speed,b.acceleration.angle,b.acceleration.duration);timer(b.acceleration.timer);
  vec(b.approach.vector);w.Values(b.approach.speed,b.approach.angle,b.approach.duration);timer(b.approach.timer);
  w.Values(b.angular.speed,b.angular.angle,b.angular.duration);timer(b.angular.timer);
  w.Values(b.reflection.speed,b.reflection.bounds.x,b.reflection.bounds.y,b.reflection.count,b.reflection.limit,b.reflection.sides,b.wrapping.count,b.wrapping.limit,b.wrapping.sides);
  vec(b.drift.velocity);w.Values(b.drift.duration,b.drift.speed,b.drift.angle);timer(b.drift.timer);
  w.Values(b.turn.speed,b.turn.angle,b.turn.duration,b.turn.limit,b.turn.count,b.turn.mode,b.turn.extra);timer(b.turn.timer);
  vec(b.position_curve.target);w.Values(b.position_curve.speed,b.position_curve.duration,b.position_curve.mode);timer(b.position_curve.timer);
  for(const auto& t:b.transforms){w.Array(t.floats);w.Array(t.integers);w.Values(t.type,t.active,u32(t.payload.size()));for(auto byte:t.payload)w.Value(byte);}
  flush();
 }
 section(3);
 auto& items=*battle.items;
 row(0,0,{bullets.first_active(),bullets.first_free(),bullets.visible_count,unsigned(items.requests),unsigned(items.cancel_density),unsigned(items.cancel_stamp),unsigned(items.alternating_pieces),unsigned(items.active_count),bits(items.motion_scale)});
 w.Values(items.requests,items.cancel_density,items.cancel_stamp,items.alternating_pieces,items.active_count,items.motion_scale);flush();
 for(u32 id=1;id<=ItemManager::pool_size;++id){const auto& item=items.find(id)->state;if(!item.state)continue;
  row(2,id,{unsigned(item.state),unsigned(item.kind),unsigned(item.appearance),item.flags,bits(item.attraction_speed),unsigned(item.delay),unsigned(item.stamp),unsigned(item.extra0),unsigned(item.extra1),unsigned(battle.mp_item_targets[id-1]),bits(item.position.x),bits(item.position.y),bits(item.velocity.x),bits(item.velocity.y),unsigned(item.age.current),unsigned(item.auxiliary.current)});
  w.Values(id,item.state,item.kind,item.appearance,item.flags,item.attraction_speed,item.delay,item.stamp,item.extra0,item.extra1,battle.mp_item_targets[id-1]);
  vec(item.position);vec(item.velocity);timer(item.age);timer(item.auxiliary);flush();
 }
 section(4);
 auto& lasers=battle.laser_scene->manager;w.Value(lasers.count());
 lasers.each([&](const LaserObject& laser){w.Values(laser.id,laser.flags,laser.state,laser.kind,laser.outside_count);timer(laser.age);timer(laser.outside_delay);
  if(auto* m=battle.laser_scene->moving_motion(laser.id)){vec(m->position);vec(m->velocity);w.Values(m->angle,m->length,m->width,m->speed,m->traveled,m->maximum_length,m->end_distance);timer(m->invulnerability);}
  if(auto* m=battle.laser_scene->stationary_motion(laser.id)){vec(m->position);vec(m->drift);w.Values(m->angle,m->length,m->width,m->speed,m->angular_velocity,m->state,m->delay,m->warmup,m->active,m->fade,m->traveled);timer(m->age);}
  flush();
 });
 section(5);spectator_lab_rows[0]=unsigned(spectator_lab_rows.size()-1);
 bytes.insert(bytes.end(),logic.begin(),logic.end());spectator_lab_logic_bytes=bytes;
}
