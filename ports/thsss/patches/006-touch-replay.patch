+	public void WriteTouch(float dx, float dy)
+	{
+		short sx = (short)Math.Max(-32767, Math.Min(32767, Math.Round(dx)));
+		short sy = (short)Math.Max(-32767, Math.Min(32767, Math.Round(dy)));
+		ReplayData.WriteByte((byte)(sx & 0xFF));
+		ReplayData.WriteByte((byte)((sx >> 8) & 0xFF));
+		ReplayData.WriteByte((byte)(sy & 0xFF));
+		ReplayData.WriteByte((byte)((sy >> 8) & 0xFF));
+	}
+
 	public int ReadKey()
 	{
 		return ReplayData.ReadByte() + (ReplayData.ReadByte() << 8);
 	}
 
+	public void ReadTouch(out float dx, out float dy)
+	{
+		int lo = ReplayData.ReadByte();
+		int hi = ReplayData.ReadByte();
+		short sx = (short)(lo + (hi << 8));
+		lo = ReplayData.ReadByte();
+		hi = ReplayData.ReadByte();
+		short sy = (short)(lo + (hi << 8));
+		dx = sx;
+		dy = sy;
+	}
+
