  "rulings": [
    {
      "topic": "Native oracle",
      "decision": "No pre-existing standalone score container found; new bounded C++ component uses existing production codec headers. No core recompilation or new native export.",
      "costIfWrong": "Does not independently establish retail/original EXE file interoperability."
    },
    {
      "topic": "Compression choices",
      "decision": "Valid literal encoding accepted by production decoder is sufficient; compression byte identity is not promised.",
      "costIfWrong": "Export is about 58KB rather than the native 9KB specimen; generic consumers must accept valid BST literal streams."
    },
    {
      "topic": "Score import",
      "decision": "Remain export-only; external bytes cannot be mislabeled as ordinary/extra native postrun capture.",
      "costIfWrong": "Generic launcher score upload remains unsupported until a distinct truthful import owner is implemented."
    }
  ],
