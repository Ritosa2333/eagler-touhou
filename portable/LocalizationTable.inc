{u8"TH05 \u539f\u901f\u4e3a 56 fps\uff1b\u6b64\u9879\u8c03\u6574\u6e38\u620f\u8fd0\u884c\u901f\u5ea6\uff0c\u97f3\u4e50\u4fdd\u6301\u539f\u901f\u3002",u8"TH05 runs at 56 fps. This changes game speed while preserving music speed.",u8"TH05 \u306e\u6a19\u6e96\u901f\u5ea6\u306f 56 fps \u3067\u3059\u3002\u30b2\u30fc\u30e0\u901f\u5ea6\u3092\u5909\u66f4\u3057\u3001\u97f3\u697d\u306e\u901f\u5ea6\u306f\u7dad\u6301\u3057\u307e\u3059\u3002"},
