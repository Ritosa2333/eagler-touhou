diff --git a/Shooting/INI_RW.cs b/Shooting/INI_RW.cs
index 0b82cb6..df92630 100644
--- a/Shooting/INI_RW.cs
+++ b/Shooting/INI_RW.cs
@@ -1,6 +1,6 @@
+using System;
+using System.Collections.Generic;
 using System.IO;
-using System.Runtime.InteropServices;
-using System.Text;
 
 namespace Shooting;
 
@@ -8,12 +8,6 @@ public class INI_RW
 {
 	public string inipath;
 
-	[DllImport("kernel32")]
-	private static extern long WritePrivateProfileString(string section, string key, string val, string filePath);
-
-	[DllImport("kernel32")]
-	private static extern int GetPrivateProfileString(string section, string key, string def, StringBuilder retVal, int size, string filePath);
-
 	public INI_RW(string INIPath)
 	{
 		inipath = INIPath;
@@ -21,18 +15,97 @@ public class INI_RW
 
 	public void IniWriteValue(string Section, string Key, string Value)
 	{
-		WritePrivateProfileString(Section, Key, Value, inipath);
+		WriteManaged(inipath, Section, Key, Value);
 	}
 
 	public string IniReadValue(string Section, string Key)
 	{
-		StringBuilder stringBuilder = new StringBuilder(500);
-		GetPrivateProfileString(Section, Key, "", stringBuilder, 500, inipath);
-		return stringBuilder.ToString();
+		return ReadManaged(inipath, Section, Key);
 	}
 
 	public bool ExistINIFile()
 	{
 		return File.Exists(inipath);
 	}
+
+	private static void WriteManaged(string path, string section, string key, string value)
+	{
+		List<string> list = new List<string>();
+		if (File.Exists(path))
+		{
+			list.AddRange(File.ReadAllLines(path));
+		}
+		string text = "[" + section + "]";
+		int num = -1;
+		int num2 = -1;
+		for (int i = 0; i < list.Count; i++)
+		{
+			string text2 = list[i].Trim();
+			if (text2.StartsWith("[") && text2.EndsWith("]"))
+			{
+				if (num >= 0 && num2 < 0)
+				{
+					break;
+				}
+				num = (string.Equals(text2, text, StringComparison.OrdinalIgnoreCase) ? i : (-1));
+			}
+			else if (num >= 0 && text2.StartsWith(key + "=", StringComparison.OrdinalIgnoreCase))
+			{
+				num2 = i;
+				break;
+			}
+		}
+		string text3 = key + "=" + value;
+		if (num2 >= 0)
+		{
+			list[num2] = text3;
+		}
+		else if (num >= 0)
+		{
+			list.Insert(num + 1, text3);
+		}
+		else
+		{
+			if (list.Count > 0)
+			{
+				list.Add("");
+			}
+			list.Add(text);
+			list.Add(text3);
+		}
+		string directoryName = Path.GetDirectoryName(path);
+		if (!string.IsNullOrEmpty(directoryName))
+		{
+			Directory.CreateDirectory(directoryName);
+		}
+		File.WriteAllLines(path, list.ToArray());
+	}
+
+	private static string ReadManaged(string path, string section, string key)
+	{
+		if (!File.Exists(path))
+		{
+			return "";
+		}
+		string[] array = File.ReadAllLines(path);
+		string text = "[" + section + "]";
+		bool flag = false;
+		for (int i = 0; i < array.Length; i++)
+		{
+			string text2 = array[i].Trim();
+			if (text2.StartsWith("[") && text2.EndsWith("]"))
+			{
+				flag = string.Equals(text2, text, StringComparison.OrdinalIgnoreCase);
+			}
+			else if (flag)
+			{
+				int num = text2.IndexOf('=');
+				if (num > 0 && string.Equals(text2.Substring(0, num).Trim(), key, StringComparison.OrdinalIgnoreCase))
+				{
+					return text2.Substring(num + 1).Trim();
+				}
+			}
+		}
+		return "";
+	}
 }

