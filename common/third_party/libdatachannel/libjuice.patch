+// ICE callbacks can block on socket polling or DNS. Scheduling them on the OS
+// pool keeps thread creation off the signaling path.
+typedef struct thread_work {
+	PTP_WORK work;
+	LPTHREAD_START_ROUTINE entry;
+	void *arg;
+} thread_work_t;
+
+static inline VOID CALLBACK thread_work_entry(PTP_CALLBACK_INSTANCE instance, PVOID context,
+                                              PTP_WORK work) {
+	(void)work;
+	thread_work_t *task = context;
+	CallbackMayRunLong(instance);
+	task->entry(task->arg);
+}
+
+static inline int thread_work_init(thread_work_t *task, LPTHREAD_START_ROUTINE entry, void *arg) {
+	task->entry = entry;
+	task->arg = arg;
+	task->work = CreateThreadpoolWork(thread_work_entry, task, NULL);
+	if (!task->work)
+		return (int)GetLastError();
+	SubmitThreadpoolWork(task->work);
+	return 0;
+}
+
+static inline void thread_work_join(thread_work_t *task) {
+	WaitForThreadpoolWorkCallbacks(task->work, TRUE);
+	CloseThreadpoolWork(task->work);
+}
+
 #else // POSIX
 
 #include <pthread.h>
