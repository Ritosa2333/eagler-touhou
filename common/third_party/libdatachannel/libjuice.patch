 #define thread_init(t, func, arg) pthread_create(t, NULL, func, arg)
 #define thread_join(t, res) (void)pthread_join(t, res)
+
+typedef thread_t thread_work_t;
+#define thread_work_init(task, entry, arg) thread_init(task, entry, arg)
+#define thread_work_join(task) thread_join(*(task), NULL)
 
