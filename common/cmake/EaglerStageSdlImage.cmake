include_guard(GLOBAL)

function(_eagler_collect_sdl_image_stage_files module prefix mode out_mappings out_identity)
    if(NOT IS_DIRECTORY "${module}")
        message(FATAL_ERROR "Required SDL_image staging source is missing: ${module}")
    endif()
    execute_process(
        COMMAND git ls-files --cached --
        WORKING_DIRECTORY "${module}"
        OUTPUT_VARIABLE _tracked
        RESULT_VARIABLE _git_result
        ERROR_VARIABLE _git_error
    )
    if(NOT _git_result EQUAL 0)
        message(FATAL_ERROR "Cannot enumerate tracked SDL_image staging inputs in ${module}: ${_git_error}")
    endif()
    string(REPLACE "\r" "" _tracked "${_tracked}")
    string(REPLACE "\n" ";" _tracked "${_tracked}")
    set(_mappings)
    set(_identity)
    set(_zconf_seen FALSE)
    foreach(_relative IN LISTS _tracked)
        if(_relative STREQUAL "")
            continue()
        endif()
        if(mode STREQUAL "SDLIMAGE" AND NOT _relative MATCHES "^[^/]+$|^(cmake|src|include)/")
            continue()
        endif()
        string(FIND "${_relative}" "|" _mapping_separator_index)
        if(_relative MATCHES "[;\r\n]" OR NOT _mapping_separator_index EQUAL -1)
            message(FATAL_ERROR "SDL_image staging does not support delimiters or control characters in tracked paths: ${_relative}")
        endif()
        set(_source "${module}/${_relative}")
        if(NOT EXISTS "${_source}" OR IS_DIRECTORY "${_source}" OR IS_SYMLINK "${_source}")
            message(FATAL_ERROR "Tracked SDL_image staging input must be a regular file: ${_source}")
        endif()
        file(SHA256 "${_source}" _sha256)
        if(mode STREQUAL "ZLIB" AND _relative STREQUAL "zconf.h")
            # SDL_image's pinned zlib CMakeLists renames this tracked header
            # from its source tree before generating the build-tree header.
            # Keep it in the source receipt, but omit it from the isolated
            # staging source so configure never mutates the pinned checkout.
            set(_zconf_seen TRUE)
            list(APPEND _identity "${prefix}/${_relative}=${_sha256}:generated-build-header")
            continue()
        endif()
        list(APPEND _mappings "${prefix}|${_relative}")
        list(APPEND _identity "${prefix}/${_relative}=${_sha256}")
    endforeach()
    if(mode STREQUAL "ZLIB" AND NOT _zconf_seen)
        message(FATAL_ERROR "Tracked zlib input is missing zconf.h: ${module}")
    endif()
    set(${out_mappings} "${_mappings}" PARENT_SCOPE)
    set(${out_identity} "${_identity}" PARENT_SCOPE)
endfunction()

function(eagler_stage_sdl_image out_source source)
    foreach(_required IN ITEMS CMakeLists.txt src include cmake)
        if(NOT EXISTS "${source}/${_required}")
            message(FATAL_ERROR "SDL_image staging source is missing ${_required}: ${source}")
        endif()
    endforeach()
    set(_zlib "${source}/external/zlib")
    set(_libpng "${source}/external/libpng")
    set(_mappings)
    set(_identity)
    _eagler_collect_sdl_image_stage_files("${source}" "SDL_image" SDLIMAGE _part_mappings _part_identity)
    list(APPEND _mappings ${_part_mappings})
    list(APPEND _identity ${_part_identity})
    _eagler_collect_sdl_image_stage_files("${_libpng}" "SDL_image/external/libpng" SUBMODULE _part_mappings _part_identity)
    list(APPEND _mappings ${_part_mappings})
    list(APPEND _identity ${_part_identity})
    _eagler_collect_sdl_image_stage_files("${_zlib}" "SDL_image/external/zlib" ZLIB _part_mappings _part_identity)
    list(APPEND _mappings ${_part_mappings})
    list(APPEND _identity ${_part_identity})

    file(SHA256 "${CMAKE_CURRENT_FUNCTION_LIST_FILE}" _helper_sha256)
    list(APPEND _identity "stage-helper=${_helper_sha256}")
    list(SORT _identity)
    string(JOIN "\n" _identity_text ${_identity})
    string(SHA256 _stage_sha256 "eagler-touhou/sdl-image-stage/1\n${_identity_text}")
    set(_stage "${CMAKE_CURRENT_BINARY_DIR}/eagler-staging/sdl-image/${_stage_sha256}")
    foreach(_mapping IN LISTS _mappings)
        string(REPLACE "|" ";" _parts "${_mapping}")
        list(GET _parts 0 _prefix)
        list(GET _parts 1 _relative)
        if(_prefix STREQUAL "SDL_image")
            set(_source_file "${source}/${_relative}")
        elseif(_prefix STREQUAL "SDL_image/external/libpng")
            set(_source_file "${_libpng}/${_relative}")
        else()
            set(_source_file "${_zlib}/${_relative}")
        endif()
        set(_destination "${_stage}/${_prefix}/${_relative}")
        get_filename_component(_destination_directory "${_destination}" DIRECTORY)
        file(MAKE_DIRECTORY "${_destination_directory}")
        configure_file("${_source_file}" "${_destination}" COPYONLY)
    endforeach()
    set(${out_source} "${_stage}/SDL_image" PARENT_SCOPE)
endfunction()
