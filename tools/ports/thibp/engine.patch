+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <utility>
+
+namespace ph3::presentation {
+
+struct Frame {
+    unsigned tick = 0;
+    double fraction = 1;
+};
+
+inline Frame currentFrame;
+
+class FrameScope {
+public:
+    FrameScope(unsigned tick, double fraction)
+        : previous_(std::exchange(currentFrame, Frame{tick, fraction})) {}
+    ~FrameScope() { currentFrame = previous_; }
+    FrameScope(const FrameScope&) = delete;
+    FrameScope& operator=(const FrameScope&) = delete;
+private:
+    Frame previous_;
+};
+
+// Presented objects only keep samples from adjacent game ticks. A newly
+// visible object and an object skipped by a scene transition use their pose.
+template<class T>
+class History {
+public:
+    const T* Observe(const T& value) {
+        const auto tick = currentFrame.tick;
+        if (!tick) return nullptr;
+        if (tick != tick_) {
+            consecutive_ = tick_ && tick - tick_ == 1;
+            std::swap(previous_, current_);
+            current_ = value;
+            tick_ = tick;
+        }
+        return consecutive_ ? &previous_ : nullptr;
+    }
+
+    void Reset() {
+        tick_ = 0;
+        consecutive_ = false;
+    }
+
+private:
+    unsigned tick_ = 0;
+    bool consecutive_ = false;
+    T previous_{};
+    T current_{};
+};
+
+inline double Mix(double from, double to) {
+    return from + (to - from) * currentFrame.fraction;
+}
+
+inline double MixAngle(double from, double to) {
+    double delta = to - from;
+    if (std::abs(delta) > 180) delta = std::remainder(delta, 360.0);
+    return from + delta * currentFrame.fraction;
+}
+
+class RefreshDetector {
+public:
+    bool Observe(double interval) {
+        // Debounce ordinary 60 Hz jitter and occasional missed high-Hz callbacks.
+        if (interval > 0 && interval <= 1000.0 / 70)
+            fastIntervals_ = std::min(6, fastIntervals_ + 1);
+        else
+            fastIntervals_ = std::max(0, fastIntervals_ - 2);
+        return fastIntervals_ >= 4;
+    }
+
+    void Reset() { fastIntervals_ = 0; }
+
+private:
+    int fastIntervals_ = 0;
+};
+
+} // namespace ph3::presentation
