+DxScriptRenderObject::RenderPose DxScriptRenderObject::GetRenderPose()
+{
+	RenderPose pose{position_, angle_, scale_};
+#ifdef __EMSCRIPTEN__
+	using namespace ph3::presentation;
+	if (const auto* previous = renderPoseHistory_.Observe(pose)) {
+		// Keep script teleports and recycled/reappearing objects discrete.
+		const auto& p = previous->position;
+		if (std::abs(pose.position.x - p.x) <= 64 &&
+			std::abs(pose.position.y - p.y) <= 64 &&
+			std::abs(pose.position.z - p.z) <= 64) {
+			const auto mix = [](D3DXVECTOR3 before, D3DXVECTOR3 after) {
+				return D3DXVECTOR3(Mix(before.x, after.x), Mix(before.y, after.y), Mix(before.z, after.z));
+			};
+			pose.position = mix(p, pose.position);
+			pose.scale = mix(previous->scale, pose.scale);
+			pose.angle = D3DXVECTOR3(MixAngle(previous->angle.x, pose.angle.x),
+				MixAngle(previous->angle.y, pose.angle.y), MixAngle(previous->angle.z, pose.angle.z));
+		}
+	}
+#endif
+	return pose;
+}
