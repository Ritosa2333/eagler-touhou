+gstd::value StgStageScript::Func_GetThibpSeatStock(gstd::script_machine* machine, int, gstd::value const* argv)
+{
+	auto* script = static_cast<StgStageScript*>(machine->data);
+	auto& stage = *script->stageController_;
+	const int seat = static_cast<int>(argv[0].as_real());
+	auto player = stage.GetPlayerObject(seat);
+	std::vector<gstd::script_real> values(6);
+	if (player != NULL)
+	{
+		values[0] = thibp::cooperativeRun().Challenge() ? player->GetChallengeDeaths() : std::max(0.0, player->GetLife());
+		values[1] = player->GetSpell();
+		values[2] = player->GetLifeFragments();
+		values[3] = player->GetBombFragments();
+		values[4] = player->IsGhost() ? 1 : 0;
+		values[5] = thibp::cooperativeRun().Challenge() ? 1 : 0;
+	}
+	return script->CreateRealArrayValue(values);
+}
