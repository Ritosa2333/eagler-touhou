+int StgStageController::FindNearestActivePlayer(double x, double y)
+{
+	int nearest = -1;
+	double distance = 0;
+	for (int seat = 0; seat < playerCount_; ++seat)
+	{
+		auto player = GetPlayerObject(seat);
+		if (player == NULL || player->GetState() != StgPlayerObject::STATE_NORMAL) continue;
+		const double dx = player->GetX() - x, dy = player->GetY() - y;
+		const double squared = dx * dx + dy * dy;
+		if (nearest < 0 || squared < distance)
+		{
+			nearest = seat;
+			distance = squared;
+		}
+	}
+	return nearest;
+}
+
+bool StgStageController::BeginCooperativeSpecial()
+{
+	if (playerCount_ == 1) return true;
+	if (playerContext_ < 0 || IsSpecialProtectionActive()) return false;
+	auto player = GetPlayerObject(playerContext_);
+	if (player == NULL || player->GetState() != StgPlayerObject::STATE_NORMAL) return false;
+	specialSeat_ = playerContext_;
+	++specialStarts_;
+	return true;
+}
+
+void StgStageController::EndCooperativeSpecial()
+{
+	if (specialSeat_ < 0 || specialSeat_ != playerContext_) return;
+	specialSeat_ = -1;
+	specialReleasedAt_ = infoStage_->GetCurrentFrame();
+}
+
+bool StgStageController::IsSpecialProtectionActive()
+{
+	return specialSeat_ >= 0 || (playerCount_ > 1 && specialReleasedAt_ == infoStage_->GetCurrentFrame());
+}
+
+bool StgStageController::IsCooperativeSpellActive(int exceptSeat)
+{
+	for (int seat = 0; seat < playerCount_; ++seat)
+	{
+		if (seat == exceptSeat) continue;
+		auto player = GetPlayerObject(seat);
+		if (player == NULL || player->IsGhost()) continue;
+		auto spell = player->GetSpellManageObject();
+		if (spell != NULL && !spell->IsDeleted()) return true;
+	}
+	return false;
+}
+
+void StgStageController::_WorkCooperativeRules()
+{
+	if (GetLivingPlayerCount() == 0)
+	{
+		++teamDownFrames_;
+		return;
+	}
+	teamDownFrames_ = 0;
+	const auto& run = thibp::cooperativeRun();
+	if (run.Challenge()) return;
+	const unsigned frame = infoStage_->GetCurrentFrame();
+	for (int seat = 0; seat < playerCount_; ++seat)
+	{
+		auto donor = GetPlayerObject(seat);
+		auto& transfer = lifeTransfers_[seat];
+		const auto keys = run.PlayerKeys(seat);
+		if (donor->GetState() != StgPlayerObject::STATE_NORMAL || donor->GetLife() < 1 ||
+			keys.data[EDirectInput::KEY_SHOT] == KEY_PUSH || keys.data[EDirectInput::KEY_SHOT] == KEY_HOLD)
+		{
+			transfer = {};
+			continue;
+		}
+
+		int recipient = -1;
+		for (int other = 0; other < playerCount_; ++other)
+		{
+			if (other == seat) continue;
+			auto candidate = GetPlayerObject(other);
+			if (candidate->GetLife() >= 8 ||
+				(!candidate->IsGhost() && candidate->GetState() != StgPlayerObject::STATE_NORMAL)) continue;
+			const double dx = donor->GetX() - candidate->GetX();
+			const double dy = donor->GetY() - candidate->GetY();
+			if (dx * dx + dy * dy > 20 * 20) continue;
+			if (recipient < 0) recipient = other;
+			else
+			{
+				auto selected = GetPlayerObject(recipient);
+				if ((candidate->IsGhost() && !selected->IsGhost()) ||
+					(candidate->IsGhost() == selected->IsGhost() && candidate->GetLife() < selected->GetLife()))
+					recipient = other;
+			}
+		}
+		if (recipient != transfer.recipient || frame - transfer.lastTap > 24) transfer = {};
+		if (recipient < 0 || keys.data[EDirectInput::KEY_SLOWMOVE] != KEY_PUSH) continue;
+
+		transfer.recipient = recipient;
+		transfer.lastTap = frame;
+		if (++transfer.count < 5) continue;
+		auto receiver = GetPlayerObject(recipient);
+		donor->SetLife(donor->GetLife() - 1);
+		if (receiver->IsGhost()) receiver->ReviveCooperative();
+		else receiver->SetLife(receiver->GetLife() + 1);
+		transfer = {};
+	}
+}
+
