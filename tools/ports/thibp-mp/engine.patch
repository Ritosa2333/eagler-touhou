+void StgPlayerObject::RestoreCooperativeStock(const thibp::SeatStock& stock)
+{
+	SetLife(stock.life);
+	SetSpell(stock.bombs);
+	SetPower(stock.power);
+	SetRebirthFrame(stock.rebirth);
+	SetInvincibilityFrame(stock.invincibility);
+	infoPlayer_->lifeFragments_ = stock.lifeFragments;
+	infoPlayer_->bombFragments_ = stock.bombFragments;
+	infoPlayer_->challengeDeaths_ = stock.deaths;
+}
+
+void StgPlayerObject::AddResourceItem(int type, int lifeLimit, int bombLimit)
+{
+	if (type == 3)
+	{
+		if (thibp::cooperativeRun().Challenge()) return;
+		if (++infoPlayer_->bombFragments_ < bombLimit) return;
+		infoPlayer_->bombFragments_ -= bombLimit;
+		SetSpell(std::min(GetSpell() + 1, 8.0));
+		return;
+	}
+	if (thibp::cooperativeRun().Challenge()) return;
+	infoPlayer_->lifeFragments_ += type == 4 ? lifeLimit : 1;
+	if (infoPlayer_->lifeFragments_ < lifeLimit) return;
+	infoPlayer_->lifeFragments_ -= lifeLimit;
+	SetLife(std::min(GetLife() + 1, 8.0));
+}
+
+bool StgPlayerObject::IsGhost() const
+{
+	return state_ == STATE_END && stageController_->GetPlayerCount() > 1;
+}
+
+void StgPlayerObject::ReviveCooperative()
+{
+	if (!IsGhost()) return;
+	StgStageController::PlayerScope player(*stageController_, seat_);
+	state_ = STATE_NORMAL;
+	bVisible_ = true;
+	SetLife(std::max(GetLife(), 0.0));
+	SetPower(0.5);
+	stageController_->GetScriptManagerP()->RequestEventAll(StgStageScript::EV_PLAYER_REBIRTH);
+	SetSpell(std::max(GetSpell() - 1, 1.0));
+	SetInvincibilityFrame(240);
+}
