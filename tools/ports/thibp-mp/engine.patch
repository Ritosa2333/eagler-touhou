+
+EMSCRIPTEN_KEEPALIVE int thibp_coop_preview(unsigned tick, unsigned one, unsigned two, unsigned three)
+{
+    auto& run = thibp::cooperativeRun();
+    if (!canPreview() || tick != run.NextTick() || !thibp::validInput(one) ||
+        !thibp::validInput(two) || !thibp::validInput(three) ||
+        (run.PlayerCount() == 2 && three)) return 0;
+    const auto stage = browserCooperativeStage();
+    const auto index = stage->GetStageInformation()->GetStageIndex();
+    run.ConsumePreview({one, two, three});
