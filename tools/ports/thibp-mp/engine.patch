+EMSCRIPTEN_KEEPALIVE int thibp_coop_configure(int players, std::uint32_t seed)
+{
+    if (players < 2 || players > thibp::maxPlayers) return 0;
+    auto* manager = ETaskManager::GetInstance();
+    if (!manager) return 0;
+    for (auto task : manager->GetTaskList()) {
+        auto* system = dynamic_cast<StgSystemController*>(task.GetPointer());
+        if (system && system->GetStageController() != NULL) return 0;
+    }
+    thibp::cooperativeRun().Configure(players, seed);
+    return 1;
