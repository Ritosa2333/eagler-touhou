+gstd::value StgStageScript::Func_GetThibpItemDistance(gstd::script_machine* machine, int, gstd::value const* argv)
+{
+	auto* script = static_cast<StgStageScript*>(machine->data);
+	auto& stage = *script->stageController_;
+	const auto id = static_cast<int>(argv[0].as_real());
+	auto item = ref_count_ptr<StgItemObject>::unsync::DownCast(stage.GetMainRenderObject(id));
+	double result = -1;
+	if (item != NULL)
+	{
+		const double x = item->GetPositionX(), y = item->GetPositionY();
+		const auto seat = stage.FindNearestActivePlayer(x, y);
+		auto player = stage.GetPlayerObject(seat);
+		if (player != NULL) result = std::hypot(player->GetX() - x, player->GetY() - y);
+	}
+	return gstd::value(machine->get_engine()->get_real_type(), static_cast<gstd::script_real>(result));
+}
