+			const double dx = x - player->GetX(), dy = y - player->GetY();
+			const double squared = dx * dx + dy * dy;
+			if (nearest < 0 || squared < nearestDistance)
+			{
+				nearest = seat;
+				nearestDistance = squared;
+			}
+			const double radius = player->GetItemIntersectionRadius();
+			if (squared <= radius * radius && (contact < 0 || squared < contactDistance))
+			{
+				contact = seat;
+				contactDistance = squared;
+			}
+		}
+		if (contact >= 0)
+		{
+			StgStageController::PlayerScope collector(*stageController_, contact);
+			item->Intersect(NULL, NULL);
+			continue;
+		}
+		if (bCancelToPlayer_ || nearest < 0)
+		{
+			item->SetCollectorSeat(-1);
+			item->SetMoveToPlayer(false);
+			continue;
+		}
+		const int previous = item->GetCollectorSeat();
+		if (previous >= 0 && !collectors[previous]) item->SetCollectorSeat(-1);
+		if (!item->IsPermitMoveToPlayer()) continue;
+		bool attract = topCollect || bAllItemToPlayer_ ||
+			listItemTypeToPlayer_.count(item->GetItemType()) != 0;
+		if (!attract)
+		{
+			for (auto& circle : listCircleToPlayer_)
+			{
+				const double dx = x - circle.GetX(), dy = y - circle.GetY();
+				if (dx * dx + dy * dy > circle.GetR() * circle.GetR()) continue;
+				attract = true;
+				break;
+			}
+		}
+		if (attract && !item->IsMoveToPlayer())
+		{
+			item->SetCollectorSeat(nearest);
+			item->SetMoveToPlayer(true);
+		}
+	}
+	listItemTypeToPlayer_.clear();
+	listCircleToPlayer_.clear();
+	bAllItemToPlayer_ = false;
+	bCancelToPlayer_ = false;
+}
