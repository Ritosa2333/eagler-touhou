+}
+EMSCRIPTEN_KEEPALIVE int thibp_coop_configure_room(int players, std::uint32_t seed, int difficulty,
+                                                  unsigned types, int challenge)
+{
+    if (players < 2 || players > thibp::maxPlayers || difficulty < 0 || difficulty > 4 ||
+        (types >> (players * 3)) != 0 || challenge < 0 || challenge > 1 ||
+        thibp::cooperativeRun().Started()) return 0;
+    for (int seat = 0; seat < players; ++seat)
+        if (((types >> (seat * 3)) & 7) >= 6) return 0;
+    thibp::cooperativeRun().Configure(players, seed, difficulty, challenge != 0, types);
+    return 1;
+}
+EMSCRIPTEN_KEEPALIVE int thibp_coop_confirm_frame(unsigned tick, unsigned one, unsigned two, unsigned three)
+{
+    return thibp::cooperativeRun().QueueFrame(tick, one, two, three) ? 1 : 0;
+}
+EMSCRIPTEN_KEEPALIVE int thibp_coop_frame()
+{
+    const auto& run = thibp::cooperativeRun();
+    return run.Started() ? static_cast<int>(run.NextTick()) : -1;
+}
+EMSCRIPTEN_KEEPALIVE std::uintptr_t thibp_coop_stage_stream()
+{
+    const auto& run = thibp::cooperativeRun();
+    if (!run.Started() || run.Viewing()) return 0;
+    static std::array<std::uint32_t, 6> status;
+    const auto& previous = run.StagePrevious();
+    status = {run.RunGeneration(), run.StageStartTick(), static_cast<unsigned>(run.StageIndex()),
+              previous[0], previous[1], previous[2]};
+    return reinterpret_cast<std::uintptr_t>(status.data());
+}
+
+EMSCRIPTEN_KEEPALIVE int thibp_coop_configure_viewer(int players, std::uint32_t seed, int difficulty,
+    unsigned types, int challenge, unsigned one, unsigned two, unsigned three, int reopen)
+{
+    auto& run = thibp::cooperativeRun();
+    if (((one | two | three) & ~thibp::validButtons) != 0 || (players == 2 && three)) return 0;
+    if (reopen && !run.Viewing()) return 0;
+    if (reopen) run.FinishRoom();
+    if (!thibp_coop_configure_room(players, seed, difficulty, types, challenge)) return 0;
+    run.SetViewer({static_cast<std::uint16_t>(one), static_cast<std::uint16_t>(two), static_cast<std::uint16_t>(three)});
+    if (reopen) SystemController::CreateInstance()->Reset();
+    return 1;
+}
+
+EMSCRIPTEN_KEEPALIVE int thibp_coop_can_preview()
