+namespace thibp {
+class CooperativeRun {
+    static constexpr unsigned queueCapacity = 64;
+    using Keys = std::array<int, virtualKeyCount>;
+
+    int playerCount_ = 1;
+    std::uint32_t seed_ = 0;
+    int roomDifficulty_ = -1;
+    bool stageStarted_ = false;
+    bool waitingForStage_ = false;
+    bool roomTitleLocked_ = false;
+    bool roomFinished_ = false;
+    bool replaying_ = false;
+    bool viewing_ = false;
+    unsigned stageStartTick_ = 0;
+    unsigned runGeneration_ = 0;
+    int stageIndex_ = 0;
+    Buttons stagePrevious_{};
+    InputFrame currentInput_{};
+    Buttons previousInput_{};
+    bool challenge_ = false;
+    unsigned playerTypes_ = 0;
+    unsigned nextInput_ = 0;
+    unsigned nextTick_ = 0;
+    std::array<InputFrame, queueCapacity> queue_{};
+    Netplay::CooperativeMenuInput<std::uint16_t, maxPlayers> menu_;
+    std::uint16_t menuHeld_ = 0;
+    bool retryPressed_ = false;
+    Keys menuKeys_{};
+    std::array<Keys, maxPlayers> playerKeys_{};
+
+    static void WriteKeys(Keys& states, unsigned held, unsigned pressed, unsigned previous)
+    {
+        for (int key = 0; key < virtualKeyCount; ++key) {
+            const unsigned flag = 1u << key;
+            states[key] = pressed & flag ? KEY_PUSH :
+                held & flag ? KEY_HOLD : previous & flag ? KEY_PULL : KEY_FREE;
+        }
+    }
+
+public:
+    void Configure(int playerCount, std::uint32_t seed, int difficulty = -1,
+                   bool challenge = false, unsigned playerTypes = 0)
+    {
+        *this = CooperativeRun{};
+        playerCount_ = playerCount;
+        seed_ = seed;
+        roomDifficulty_ = difficulty;
+        waitingForStage_ = true;
+        roomTitleLocked_ = difficulty >= 0;
+        challenge_ = challenge;
+        playerTypes_ = playerTypes;
+    }
+    int TakeRoomDifficulty()
+    {
+        const int current = roomDifficulty_;
+        roomDifficulty_ = -1;
+        return current;
+    }
+    int PlayerCount() const { return playerCount_; }
+    bool Challenge() const { return challenge_; }
+    bool RetryPressed() const { return retryPressed_; }
+    unsigned PlayerType(int seat) const { return (playerTypes_ >> (seat * 3)) & 7; }
+    unsigned ShotGroup(int seat) const { return PlayerType(seat) / 2; }
+    unsigned PlayerTypes() const { return playerTypes_; }
+    bool WaitingForStage() const { return waitingForStage_; }
+    bool RoomFinished() const { return roomFinished_; }
+    bool RoomTitleLocked() const { return roomTitleLocked_; }
+    void SetRoomTitleLocked(bool locked) { roomTitleLocked_ = locked; }
+    bool Replaying() const { return replaying_; }
+    const InputFrame& CurrentInput() const { return currentInput_; }
+    const Buttons& PreviousInput() const { return previousInput_; }
+
+    void FinishRoom()
+    {
+        if (!Started()) return;
+        stageStarted_ = false;
+        waitingForStage_ = false;
+        roomFinished_ = true;
+    }
+    void PrepareReplay(const StageReplay& replay)
+    {
+        replaying_ = replay.playerCount > 1;
+        if (!replaying_) return;
+        playerCount_ = replay.playerCount;
+        playerTypes_ = replay.playerTypes;
+        challenge_ = replay.challenge;
+        menu_.previous = replay.previous;
+        menuHeld_ = 0;
+        for (auto held : replay.previous) menuHeld_ |= held;
+    }
+    std::uint32_t StageSeed(unsigned stage) const { return seed_ ^ (0x9e3779b9u * stage); }
+    void BeginStage(int index)
+    {
+        if (stageStarted_ && (index == 1 || index == 7)) ++runGeneration_;
+        stageStarted_ = true;
+        roomTitleLocked_ = false;
+        stageStartTick_ = nextTick_;
+        stageIndex_ = index;
+        stagePrevious_ = menu_.previous;
+    }
+    unsigned StageStartTick() const { return stageStartTick_; }
+    unsigned RunGeneration() const { return runGeneration_; }
+    int StageIndex() const { return stageIndex_; }
+    const Buttons& StagePrevious() const { return stagePrevious_; }
+    bool Viewing() const { return viewing_; }
+    void SetViewer(const Buttons& previous)
+    {
+        viewing_ = true;
+        menu_.previous = previous;
+        menuHeld_ = 0;
+        for (auto bits : previous) menuHeld_ |= bits;
+    }
+    bool Started() const { return stageStarted_; }
+    unsigned NextTick() const { return nextTick_; }
+    bool CanPreview() const { return Started() && !Viewing() && nextTick_ == nextInput_; }
+
+    void ConsumePreview(const InputFrame& inputs)
+    {
+        ++nextTick_;
+        ++nextInput_;
+        ApplyInputs(inputs);
+    }
+
+    bool QueueFrame(unsigned frame, unsigned one, unsigned two, unsigned three)
+    {
+        if (playerCount_ < 2 || frame != nextInput_ || nextInput_ - nextTick_ == queueCapacity ||
+            !validInput(one) || !validInput(two) || !validInput(three) || (playerCount_ == 2 && three != 0))
+            return false;
+        queue_[nextInput_ % queueCapacity] = {one, two, three};
+        ++nextInput_;
+        return true;
+    }
+
+    bool ConsumeFrame()
+    {
+        if (nextTick_ == nextInput_) return false;
+        const InputFrame& frame = queue_[nextTick_ % queueCapacity];
+        ++nextTick_;
+        ApplyInputs(frame);
+        return true;
+    }
+
+    void ApplyInputs(const InputFrame& frame)
+    {
+        previousInput_ = menu_.previous;
+        currentInput_ = frame;
+        Buttons buttons{};
+        for (int seat = 0; seat < playerCount_; ++seat) {
+            buttons[seat] = static_cast<std::uint16_t>(frame[seat] & validButtons);
+            const auto previous = menu_.previous[seat];
+            WriteKeys(playerKeys_[seat], buttons[seat], buttons[seat] & ~previous, previous);
+        }
+        const auto menu = menu_.Update(buttons, playerCount_);
+        WriteKeys(menuKeys_, menu.held, menu.pressed, menuHeld_);
+        menuHeld_ = menu.held;
+        retryPressed_ = (menu.pressed & retryButton) != 0;
+    }
+
+    VirtualKeyManager::KeyStates PlayerKeys(int seat) const
+    {
+        return {playerKeys_[seat].data(), virtualKeyCount};
+    }
+    VirtualKeyManager::KeyStates RecordedMenuKeys() const
+    {
+        return {menuKeys_.data(), virtualKeyCount};
+    }
+    VirtualKeyManager::KeyStates MenuKeys() const
+    {
+        if (Started() || RoomTitleLocked()) return RecordedMenuKeys();
+        return {};
+    }
+};
+
+inline CooperativeRun& cooperativeRun()
+{
+    static CooperativeRun run;
+    return run;
+}
