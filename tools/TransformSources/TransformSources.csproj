<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>TransformSources</AssemblyName>
    <RootNamespace>Thsss.Tools.TransformSources</RootNamespace>
    <RuntimeIdentifier></RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <UseAppHost>false</UseAppHost>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>$(MSBuildThisFileDirectory)../../THSSS.Browser/obj/transform-sources/</OutputPath>
    <IntermediateOutputPath>$(MSBuildThisFileDirectory)../../THSSS.Browser/obj/transform-sources/i/</IntermediateOutputPath>
  </PropertyGroup>
</Project>
